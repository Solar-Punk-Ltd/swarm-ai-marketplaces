# Marketplace treasury address, shown in the Treasury section.
VITE_TREASURY_ADDRESS=

# SplitterFactory to enumerate. See packages/contracts/deployments/<network>.json.
VITE_SPLITTER_FACTORY_ADDRESS=

# Chain to read. 84532 = Base Sepolia (default), 8453 = Base mainnet.
VITE_CHAIN_ID=84532

# EVM RPC endpoint. Defaults to https://base-sepolia-rpc.publicnode.com.
#
# NOT sepolia.base.org: it is fronted by QuickNode with a 25-calls-per-second cap that counts each
# element of a JSON-RPC batch as its own call, so batching gives no relief at all. Reads are
# aggregated through Multicall3 now (two eth_calls per tick regardless of seller count), which is
# what actually fixes it — but there is no reason to pick the tightest cap as the default.
#
# Whatever you set must have Multicall3 at 0xcA11bde05977b3631167028862bE2a173976CA11; every
# balance read goes through it. Avoid drpc.org's free tier, which rejects batches over 3 entries.
VITE_RPC_URL=

# Balance poll interval in milliseconds.
VITE_REFRESH_INTERVAL_MS=5000

# ERC-8004 Identity Registry, used to label seller rows with the agent that owns each splitter.
# Defaults to the known deployment for VITE_CHAIN_ID; leave blank unless overriding.
# Optional — without it the dashboard simply shows no agent identity.
VITE_IDENTITY_REGISTRY_ADDRESS=

# Block to start the agent_splitter log sweep from. Defaults to the registry deploy block.
VITE_IDENTITY_REGISTRY_FROM_BLOCK=

# Blocks per eth_getLogs call. Lower this if the agent index comes back partial because the
# node rejects wide ranges.
VITE_LOG_CHUNK_BLOCKS=500000

# Gateway used to resolve bzz:// Agent Card URIs when labelling seller rows with an agent name,
# and to resolve each seller's catalog feed for the "Catalog" link. Best-effort: a gateway that
# blocks CORS or times out just leaves the bare agent id and no catalog link.
#
# Catalogs published to a local Bee node do not exist on the public gateway, so point this at that
# node while developing: VITE_SWARM_GATEWAY_URL=http://localhost:1633
VITE_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org

# Devcon demo pages (/devcon and /claim-wallet). Off by default: they are demo scaffolding, not
# product surface. When off the "Devcon" nav item is hidden and both paths fall back to the
# Dashboard. Only "true" or "false" are accepted — a typo refuses to boot rather than reading as off.
VITE_SHOW_DEMO_FLOW=false

# Base URL the /devcon QR code points at. Unset means window.location.origin, which is only
# scannable when this dashboard is reached over the network: a phone cannot resolve localhost, so
# run `pnpm dev -- --host` and open it by LAN IP. Set this to a tunnel URL (ngrok, cloudflared) when
# the demo machine is not on the same network as the audience. Validated only when the flag is on.
VITE_DEMO_FLOW_BASE_URL=

# agent-orchestration-api base URL — the backend in the sibling `swarm-agent-demo` repo that the
# /claim-wallet page calls to have a buyer agent deployed for each visitor. Validated only when
# VITE_SHOW_DEMO_FLOW is on; unset just leaves that page saying it is not configured.
#
# Must be reachable FROM THE PHONE, so a LAN IP or tunnel, never localhost — and the API's own
# DEVCON_ALLOWED_ORIGINS must list this dashboard's origin, or the browser blocks every call.
# There is no Vite proxy for it: a dev-server proxy exists in neither `pnpm preview` nor a static
# deploy, and the QR code long outlives the dev server that printed it.
# e.g. VITE_DEVCON_API_URL=http://192.168.1.20:8000
VITE_DEVCON_API_URL=

# ── Swarm deploy (`pnpm run deploy`) ─────────────────────────────────────────
# Read by scripts/deploy-swarm.mjs, NOT by the app. Deliberately without a VITE_ prefix: Vite
# inlines every VITE_* var into the bundle, and a postage batch id is a spending credential.
# Vite ignores everything below, which is the whole point of the naming.

# Bee node that performs the upload. A light node is enough.
BEE_API_URL=http://localhost:1633

# Postage batch to stamp the upload with. Required — the deploy refuses to run without it.
# List yours with: curl http://localhost:1633/stamps
POSTAGE_BATCH_ID=

# Host serving <cid>.<host>. This is the URL to hand out: it serves the app at the root, which
# is what vite.config.ts's base assumes. The path form (<gateway>/bzz/<ref>/) loads but breaks
# on the first in-app navigation.
SWARM_SUBDOMAIN_GATEWAY=bzz.link

# Gateway used only for the printed path-form URL.
SWARM_PATH_GATEWAY=https://api.gateway.ethswarm.org

# "true" returns as soon as the local node holds the data, before it has pushed it to the
# network — faster, but the deploy can report success on content no gateway can resolve yet.
# Left unset the upload waits, which is what you want for anything anyone else will open.
SWARM_DEFERRED=

# Upload timeout in ms. A synchronous upload on a light node is minutes, not seconds.
SWARM_UPLOAD_TIMEOUT_MS=600000

# Signer for the stable feed every deploy is written to. Set this to give the dashboard ONE address
# that survives redeploys: the script prints a feed manifest reference and its ENS contenthash, which
# you set on the ENS name once. After that, `pnpm run deploy` moves the name with no ENS transaction.
# Use a dedicated key, not a funded wallet — it signs feed chunks only and needs no balance. Keep it:
# a different key is a different feed, so losing it means a new contenthash on ENS.
# Unset: each deploy gets only its own immutable address, as before.
SWARM_FEED_PK=

# Feed topic name (hashed to the topic). Part of the stable address: changing it forks the feed.
SWARM_FEED_TOPIC=swarm-ai-marketplace-ui
