# --- HTTP server ---
PORT=3100

# --- Chain (Base Sepolia by default) ---
NETWORK=eip155:84532
RPC_URL=https://sepolia.base.org
# Archive node for state at past blocks (PoP: the agent's splitter link at settlement).
# Leave blank only if RPC_URL is itself an archive node.
ARCHIVE_RPC_URL=
# Log pages for eth_getLogs scans — keep within your provider's block-range cap.
LOG_RANGE_MAX=200

# --- ERC-8004 registries (shared singletons; adapter defaults per chain) ---
ERC8004_CHAIN=base-sepolia
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=

# --- This marketplace (no defaults: the repo is a framework for many marketplaces) ---
# Your deployed SplitterFactory (packages/contracts, Deploy.s.sol).
SPLITTER_FACTORY_ADDRESS=
# Accepted clone terms "treasury:taxBps,..." — blank = the factory's current treasury + defaultTaxBps.
SPLITTER_TERMS=
# ERC-20 tokens accepted as payment (comma-separated addresses).
ACCEPTED_ASSETS=
# Minimum purchase per token in base units, "token:amount,..." (blank = no floor).
VALUE_FLOOR=
# Review score range in score units (e.g. 0–100, or 1–5 with SCORE_DECIMALS=1 for 4.5).
# On-chain value = score x 10^SCORE_DECIMALS.
SCORE_MIN=0
SCORE_MAX=100
SCORE_DECIMALS=0

# --- Envelope limits ---
MAX_CHUNKS_PER_REQUEST=16
# Total envelopes per purchase across all requests (default 4 x MAX_CHUNKS_PER_REQUEST).
MAX_ENVELOPES_PER_PURCHASE=
# Envelope-request signatures older than this are rejected.
REQUEST_MAX_AGE_SECONDS=300

# --- Bee / review batches ---
# The node's wallet needs xBZZ (and xDAI for gas): it buys one immutable batch per seller.
BEE_API_URL=http://localhost:1633
REVIEW_BATCH_SIZE_MB=1
REVIEW_BATCH_TTL_DAYS=30
# Retry-After sent while a new seller batch is not yet usable.
BATCH_RETRY_AFTER_SECONDS=60

# --- Indexer (GET /v1/sellers/:agentId/reputation) ---
INDEXER_ENABLED=true
# First block to index. Use the ReputationRegistry deploy block for a complete index; blank =
# head minus ~550k blocks on first start (older reviews are then missing and buyers' census checks
# will flag the indexer as incomplete).
INDEXER_START_BLOCK=
# Stay this many blocks behind head (reorgs).
INDEXER_CONFIRMATIONS=5
# Blocks ingested per tick while backfilling (default 10 x LOG_RANGE_MAX).
INDEXER_MAX_BLOCKS_PER_TICK=
# Reviews verified per tick, and fetch retries before unresolvable content counts as invalid.
INDEXER_VERIFY_BATCH=20
INDEXER_MAX_ATTEMPTS=5
INDEXER_POLL_SECONDS=15

# --- CORS (read-only GET endpoints: /v1/reviews/config, /v1/sellers/*) ---
# Origins allowed to read them from a browser (e.g. marketplace-ui), comma-separated, or * for any.
# The data is public, so * is the default. POST /v1/reviews/envelopes never gets CORS headers.
CORS_ALLOWED_ORIGINS=*

# --- Storage ---
DB_PATH=./data/marketplace.db
