# Bee node endpoint
BEE_API_URL=http://localhost:1633

# Catalog feed signer private key (cold key)
BEE_FEED_PK=

# Per-item state feed signer private key (hot key) — MUST differ from BEE_FEED_PK
ITEM_STATE_FEED_PK=

# Postage stamp batch ID for uploads
POSTAGE_BATCH_ID=

# EVM wallet private key used by register_agent to mint the ERC-8004 NFT and deploy the
# seller's RevenueSplitter clone. Must own the agent NFT to write registry metadata.
# Also required by any tool that transacts on-chain. Wallet must be funded on the target chain.
PRIVATE_KEY=

# ERC-8004 chain + RPC. Defaults come from src/constants.ts (base-sepolia).
# RPC_URL=
# ERC8004_CHAIN=base-sepolia

# --- Revenue splitter (@solarpunk/contracts) ---
# SplitterFactory address on the ERC8004_CHAIN network (see packages/contracts/deployments/).
SPLITTER_FACTORY_ADDRESS=

# Seller address whose splitter receives listing payments. With both values set, build_catalog
# resolves payment[].payTo to this seller's clone, and rejects any listing that names a different
# payTo — settling elsewhere is untaxed and earns no Proof-of-Purchase.
AGENT_PAYMENT_ADDRESS=

# Key of AGENT_PAYMENT_ADDRESS (optional). Only needed when that address is not the PRIVATE_KEY
# owner: register_agent then registers it as the ERC-8004 agent wallet, which Proof-of-Purchase
# requires. Without it, register_agent returns the consent to sign elsewhere (agentWalletConsent).
AGENT_PAYMENT_PK=

# --- Buyer: purchases and reviews ---
# Buyer wallet: signs purchases (PurchaseIntent + ERC-3009), the review feed and giveFeedback.
# Needs ETH on the ERC-8004 chain for giveFeedback / revokeFeedback gas.
BUYER_WALLET_PK=
# RPC used to read the payment token's EIP-712 domain at purchase time.
PAYMENT_RPC_URL=
# Fallback x402 base URL when purchase_catalog_item omits x402Endpoint.
X402_ENDPOINT=
# Local store of purchases (incl. the signed PurchaseIntent needed to review them later).
BUYER_DB_PATH=./data/buyer.db
# The marketplace backend (packages/marketplace-service): review config, storage envelopes.
MARKETPLACE_SERVICE_URL=
# Archive node for Proof-of-Purchase checks that read past state (falls back to RPC_URL).
ARCHIVE_RPC_URL=
# eth_getLogs page size — keep within your RPC provider's block-range cap.
LOG_RANGE_MAX=200
